# Opção 1 - AWS Secrets Manager (recomendado em produção)
# A EC2 precisa de uma IAM Role com permissão secretsmanager:GetSecretValue
# para o secret abaixo. As credenciais do RDS são lidas do secret, não daqui.
DB_SECRET_NAME=togglemaster-prd-db-credentials
AWS_REGION=us-east-2

# Opção 2 - Usuário/senha tradicional via variável de ambiente
# Só é usada se DB_SECRET_NAME não estiver definida acima.
DB_HOST=<endpoint-do-rds-mysql>
DB_PORT=3306
DB_NAME=togglemaster
DB_USER=<usuario-admin-do-rds>
DB_PASSWORD=<senha-do-usuario-admin>
